# Copie este arquivo para ".env" (sem o "exemplo") e preencha só o que for usar.
# O .env NUNCA vai para o repositório (está no .gitignore).
# O edge-tts (motor padrão) não precisa de chave.

# Azure Speech (portal.azure.com -> recurso "Speech" -> Chaves e ponto de extremidade)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth

# ElevenLabs (elevenlabs.io -> Profile -> API Keys)
ELEVENLABS_API_KEY=
